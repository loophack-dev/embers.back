# Supabase project URL (local: http://127.0.0.1:54321, remote: https://<project-ref>.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321
# Backend key used for Storage and administration. Local value: `npx supabase status -o env` (SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection.
# Local:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Remote: session-mode pooler (port 5432), e.g.
#         postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Fixed id of the default workspace. Must match supabase/migrations/*_create_workspaces.sql
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# Optional: model providers. A provider is available when its key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: origins allowed for the front end. "*" (default) allows any origin;
# use a comma-separated list to restrict, e.g. http://localhost:5173
CORS_ORIGINS=*

# Optional: path to the provider/model catalog (default: config/providers.yaml)
# PROVIDERS_FILE=config/providers.yaml

# Agent runtime: strands (default, calls the provider) or fake (no model calls)
AGENT_RUNTIME=strands
# Seconds the fake runtime waits before answering
FAKE_RUNTIME_DELAY_S=3

# Max seconds of agent work per task (waiting for answers does not count)
TASK_TIMEOUT_S=600
# Max seconds to wait for an answer to a question
ASK_TIMEOUT_S=1800
# Max questions (ask_user) per task
MAX_QUESTIONS_PER_TASK=3

# Storage bucket for generated files and lifetime (seconds) of signed download URLs
ARTIFACTS_BUCKET=artifacts
SIGNED_URL_TTL_S=3600
# Optional .pptx template for presentations (empty = python-pptx default)
PPTX_TEMPLATE_PATH=
